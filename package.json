{
  "name": "isolated-sources",
  "version": "1.0.0",
  "description": "Local identifier scrubber that finds and replaces common identifiers in the browser.",
  "type": "module",
  "license": "MIT",
  "author": "Joe Ball",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desynced/isolated-sources.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "dev:site": "vite --config site/vite.config.ts",
    "build:site": "tsc -p site/tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit && vite build --config site/vite.config.ts",
    "preview:site": "vite preview --config site/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "happy-dom": "^15.11.7",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
