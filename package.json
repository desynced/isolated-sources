{
  "name": "isolated-sources",
  "version": "1.0.0",
  "description": "Local identifier scrubber that finds and replaces common identifiers in the browser.",
  "type": "module",
  "license": "MIT",
  "author": "Joe Ball",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desynced/isolated-sources.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
